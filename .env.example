# Copy this file to .env or set these variables in your shell.
# Do NOT commit real credentials.
STUDENT_MENTOR_SECRET=replace-with-a-long-random-secret
STUDENT_MENTOR_DB_HOST=localhost
STUDENT_MENTOR_DB_PORT=3306
STUDENT_MENTOR_DB_USER=root
STUDENT_MENTOR_DB_PASSWORD=your-mysql-password
STUDENT_MENTOR_DB_NAME=student_mentor

# Public website domain. Replace with your real deployed/custom domain.
STUDENT_MENTOR_DOMAIN=studentmentorproject.example
